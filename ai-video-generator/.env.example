# Server
PORT=3000
NODE_ENV=production
JWT_SECRET=change_me_to_a_long_random_string
FRONTEND_URL=https://your-app.up.railway.app

# MongoDB (Railway MongoDB plugin or Atlas)
MONGO_URI=mongodb://mongo:27017/ai-video-generator

# AI Video Provider
# Supported: kling | runway | veo | mock
API_PROVIDER=mock
API_KEY=your_ai_provider_api_key_here
# Optional base URL override (leave empty for defaults)
API_BASE_URL=

# Credits cost per generation (by duration)
CREDIT_COST_3S=1
CREDIT_COST_5S=2
CREDIT_COST_10S=4

# Initial free credits for new users
FREE_CREDITS=3

# Payment providers (Uzbekistan)
# Payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# Click
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Uzum
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# OTP via Telegram bot (optional – plug into existing Telegraf.js bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OTP_CHAT_ID=
OTP_EXPIRE_MINUTES=5

# Email (optional fallback auth)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
